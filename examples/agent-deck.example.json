{
  "idleAfterMs": 5000,
  "notifyUrl": "http://127.0.0.1:9000/hooks/agent-deck",
  "agents": {
    "demo": {
      "command": "node",
      "args": ["-e", "let i=0;setInterval(()=>console.log('tick',++i),1000)"],
      "description": "Demo ticker that prints a line every second."
    },
    "tests": {
      "command": "npm",
      "args": ["test"],
      "description": "Run the project test suite."
    },
    "repl": {
      "command": "node",
      "args": ["-e", "const rl=require('readline').createInterface({input:process.stdin});rl.on('line',(line)=>console.log('echo:',line))"],
      "pty": true,
      "description": "Echo console that expects a pseudo-terminal."
    },
    "commit-helper": {
      "command": "npx",
      "args": ["-y", "commitsmith", "--json"],
      "description": "Suggest a conventional commit from the staged diff."
    }
  }
}
